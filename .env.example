# Required for deployed sessions. Generate with: openssl rand -base64 32
RIVET_DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-only Rivet control-plane credentials. Set either this endpoint with
# backend credentials or RIVET_TOKEN before a production deploy.
# RIVET_ENDPOINT=https://namespace:backend-token@api.rivet.dev
# RIVET_TOKEN=backend-token

# Optional. RivetKit defaults to the local /api/rivet route in a browser.
NEXT_PUBLIC_RIVET_ENDPOINT=http://localhost:3000/api/rivet
